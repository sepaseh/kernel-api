{
  "schemaVersion": 1,
  "tasks": [
    {
      "id": "guidance",
      "when": "Change published instructions, navigation, validation policy or assistant workflows.",
      "owners": [
        "AGENTS.md",
        ".agents/README.md",
        ".agents/settings.json",
        ".agents/navigation.json",
        ".agents/validation.json",
        "scripts/check-governance.mjs"
      ],
      "contracts": [
        "docs/source-navigation.md",
        ".agents/rules/guidance.md",
        "docs/validation.md",
        "CONTRIBUTING.md"
      ],
      "tests": ["scripts/check-governance.test.mjs"],
      "checks": [
        "snapshot",
        "ci-policy",
        "guidance",
        "format",
        "coverage-tests"
      ]
    },
    {
      "id": "git-policy",
      "when": "Prepare branches, commits, successive PRs, review settings or provider evidence.",
      "owners": [
        ".github/rulesets/bootstrap.json",
        ".github/rulesets/main.json",
        ".github/workflows/ci.yml",
        ".github/workflows/pr-policy.yml",
        ".github/workflows/coderabbit-approval.yml",
        ".github/workflows/review-events.yml",
        "scripts/check-pr-size.mjs",
        "scripts/check-coderabbit-approval.mjs",
        "scripts/ci-evidence.mjs"
      ],
      "contracts": [
        ".agents/rules/git.md",
        ".agents/rules/branches.md",
        ".agents/rules/pull-requests.md",
        "docs/branch-protection.md",
        "docs/sonarqube.md"
      ],
      "tests": [
        "scripts/check-pr-size.test.mjs",
        "scripts/check-coderabbit-approval.test.mjs",
        "scripts/ci-evidence.test.mjs",
        "scripts/check-governance.test.mjs"
      ],
      "checks": [
        "snapshot",
        "ci-policy",
        "guidance",
        "format",
        "coverage-tests"
      ]
    },
    {
      "id": "pure-foundation",
      "when": "Change published pure contracts, identity, authorization or validation policy.",
      "owners": [
        "src/application/authorization.ts",
        "src/application/errors.ts",
        "src/application/identity.ts",
        "src/application/models.ts",
        "src/application/permissions.ts",
        "src/application/validation.ts"
      ],
      "contracts": [
        "src/contracts/locales.ts",
        "src/contracts/otp.ts",
        "src/contracts/permissions.ts",
        "src/contracts/profile.ts",
        "src/application/ports/auth.ts",
        ".agents/rules/backend.md",
        ".agents/rules/imports.md",
        "src/contracts/settings.ts"
      ],
      "tests": [
        "src/application/foundation.test.ts",
        "src/application/validation.test.ts",
        "scripts/check-boundaries.test.mjs"
      ],
      "checks": ["boundaries", "typecheck", "lint", "coverage-tests"]
    }
  ]
}
