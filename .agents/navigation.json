{
  "schemaVersion": 1,
  "tasks": [
    {
      "id": "guidance",
      "when": "Change published instructions, navigation, validation policy or assistant workflows.",
      "owners": [
        "AGENTS.md",
        ".agents/README.md",
        ".agents/settings.json",
        ".agents/navigation.json",
        ".agents/validation.json",
        "scripts/check-governance.mjs"
      ],
      "contracts": [
        "docs/source-navigation.md",
        ".agents/rules/guidance.md",
        "docs/validation.md",
        "CONTRIBUTING.md"
      ],
      "tests": ["scripts/check-governance.test.mjs"],
      "checks": [
        "snapshot",
        "ci-policy",
        "guidance",
        "format",
        "coverage-tests"
      ]
    },
    {
      "id": "git-policy",
      "when": "Prepare branches, commits, successive PRs, review settings or provider evidence.",
      "owners": [
        ".github/rulesets/bootstrap.json",
        ".github/rulesets/main.json",
        ".github/workflows/ci.yml",
        ".github/workflows/pr-policy.yml",
        ".github/workflows/coderabbit-approval.yml",
        ".github/workflows/review-events.yml",
        "scripts/check-pr-size.mjs",
        "scripts/check-coderabbit-approval.mjs",
        "scripts/ci-evidence.mjs"
      ],
      "contracts": [
        ".agents/rules/git.md",
        ".agents/rules/branches.md",
        ".agents/rules/pull-requests.md",
        "docs/branch-protection.md",
        "docs/sonarqube.md"
      ],
      "tests": [
        "scripts/check-pr-size.test.mjs",
        "scripts/check-coderabbit-approval.test.mjs",
        "scripts/ci-evidence.test.mjs",
        "scripts/check-governance.test.mjs"
      ],
      "checks": [
        "snapshot",
        "ci-policy",
        "guidance",
        "format",
        "coverage-tests"
      ]
    },
    {
      "id": "pure-foundation",
      "when": "Change published pure contracts, identity, authorization or validation policy.",
      "owners": [
        "src/application/authorization.ts",
        "src/application/errors.ts",
        "src/application/identity.ts",
        "src/application/models.ts",
        "src/application/permissions.ts",
        "src/application/validation.ts"
      ],
      "contracts": [
        "src/contracts/locales.ts",
        "src/contracts/otp.ts",
        "src/contracts/permissions.ts",
        "src/contracts/profile.ts",
        "src/application/ports/auth.ts",
        ".agents/rules/backend.md",
        ".agents/rules/imports.md",
        "src/contracts/settings.ts"
      ],
      "tests": [
        "src/application/foundation.test.ts",
        "src/application/validation.test.ts",
        "scripts/check-boundaries.test.mjs"
      ],
      "checks": ["boundaries", "typecheck", "lint", "coverage-tests"]
    },
    {
      "id": "services-and-catalogs",
      "when": "Change published application policies, ports, feature contracts or API catalog data.",
      "owners": [
        "src/application/account.ts",
        "src/application/auth.ts",
        "src/application/calendar.ts",
        "src/application/files.ts",
        "src/application/roles.ts",
        "src/application/settings.ts",
        "src/application/users.ts",
        "src/application/ports",
        "src/infrastructure/localization/catalogs"
      ],
      "contracts": [
        "src/contracts",
        ".agents/rules/backend.md",
        ".agents/rules/data-lifecycle.md",
        ".agents/rules/localization.md",
        "docs/input-validation.md",
        "docs/localization.md",
        "docs/sequences.md"
      ],
      "tests": [
        "src/application/account.test.ts",
        "src/application/auth.test.ts",
        "src/application/files.test.ts",
        "src/application/management.test.ts",
        "src/application/users.test.ts",
        "src/infrastructure/localization/catalogs.test.ts"
      ],
      "checks": ["boundaries", "typecheck", "lint", "coverage-tests"]
    },
    {
      "id": "configuration-and-storage",
      "when": "Change runtime configuration, translation, logging, fatal handlers or local/MinIO storage adapters.",
      "owners": [
        "src/infrastructure/config.ts",
        "src/infrastructure/lifecycle.ts",
        "src/infrastructure/localization/i18n.ts",
        "src/infrastructure/logging",
        "src/infrastructure/storage"
      ],
      "contracts": [
        "src/application/ports/object-storage.ts",
        "docs/backend-logging.md",
        "docs/object-storage.md",
        ".agents/rules/localization.md",
        ".agents/rules/data-lifecycle.md"
      ],
      "tests": [
        "src/infrastructure/config.test.ts",
        "src/infrastructure/lifecycle.test.ts",
        "src/infrastructure/localization/i18n.test.ts",
        "src/infrastructure/logging/logger.test.ts",
        "src/infrastructure/storage/local.test.ts",
        "src/infrastructure/storage/minio.test.ts"
      ],
      "checks": ["boundaries", "typecheck", "lint", "coverage-tests"]
    },
    {
      "id": "database-auth",
      "when": "Change schema, reviewed migrations, persistence, authentication adapters or administrator provisioning.",
      "owners": [
        "drizzle",
        "src/infrastructure/db",
        "src/infrastructure/persistence",
        "src/infrastructure/auth",
        "src/infrastructure/admin/bootstrap.ts",
        "src/bootstrap-admin.ts"
      ],
      "contracts": [
        "docs/database-schema.md",
        "docs/auth-adapters.md",
        ".agents/rules/backend.md",
        ".agents/rules/data-lifecycle.md"
      ],
      "tests": [
        "scripts/auth-bootstrap-integration.test.mjs",
        "scripts/auth-identity-integration.test.mjs",
        "src/infrastructure/auth/gateway.test.ts",
        "src/test/integration/management-services.test.ts",
        "src/test/integration/persistence.test.ts",
        "src/test/integration/users-lifecycle.test.ts",
        "src/test/support/fixture-cleanup.test.ts",
        "scripts/runtime-seed.test.mjs"
      ],
      "checks": ["boundaries", "typecheck", "lint", "coverage-tests"]
    }
  ]
}
