{
  "schemaVersion": 1,
  "tasks": [
    {
      "id": "guidance",
      "when": "Change published instructions, navigation, validation policy or assistant workflows.",
      "owners": [
        "AGENTS.md",
        ".agents/README.md",
        ".agents/settings.json",
        ".agents/navigation.json",
        ".agents/validation.json",
        "scripts/check-governance.mjs"
      ],
      "contracts": [
        "docs/source-navigation.md",
        ".agents/rules/guidance.md",
        "docs/validation.md",
        "CONTRIBUTING.md"
      ],
      "tests": ["scripts/check-governance.test.mjs"],
      "checks": [
        "snapshot",
        "ci-policy",
        "guidance",
        "format",
        "coverage-tests"
      ]
    },
    {
      "id": "git-policy",
      "when": "Prepare branches, commits, successive PRs, review settings or provider evidence.",
      "owners": [
        ".github/rulesets/main.json",
        ".github/workflows/ci.yml",
        ".github/workflows/codeql.yml",
        "scripts/ci-evidence.mjs",
        "scripts/run-actionlint.mjs"
      ],
      "contracts": [
        ".agents/rules/git.md",
        ".agents/rules/branches.md",
        ".agents/rules/pull-requests.md",
        "docs/branch-protection.md",
        "docs/sonarqube.md"
      ],
      "tests": [
        "scripts/ci-evidence.test.mjs",
        "scripts/check-governance.test.mjs",
        "scripts/run-actionlint.test.mjs"
      ],
      "checks": [
        "snapshot",
        "ci-policy",
        "actions-lint",
        "guidance",
        "format",
        "coverage-tests"
      ]
    },
    {
      "id": "pure-foundation",
      "when": "Change published pure contracts, identity, authorization or validation policy.",
      "owners": [
        "src/application/authorization.ts",
        "src/application/errors.ts",
        "src/application/identity.ts",
        "src/application/models.ts",
        "src/application/permissions.ts",
        "src/application/validation.ts"
      ],
      "contracts": [
        "src/contracts/locales.ts",
        "src/contracts/otp.ts",
        "src/contracts/permissions.ts",
        "src/contracts/profile.ts",
        "src/application/ports/auth.ts",
        ".agents/rules/backend.md",
        ".agents/rules/imports.md",
        "src/contracts/settings.ts"
      ],
      "tests": [
        "src/application/foundation.test.ts",
        "src/application/validation.test.ts",
        "scripts/check-boundaries.test.mjs"
      ],
      "checks": ["boundaries", "typecheck", "lint", "coverage-tests"]
    },
    {
      "id": "services-and-catalogs",
      "when": "Change published application policies, ports, feature contracts or API catalog data.",
      "owners": [
        "src/application/account.ts",
        "src/application/auth.ts",
        "src/application/calendar.ts",
        "src/application/files.ts",
        "src/application/roles.ts",
        "src/application/settings.ts",
        "src/application/users.ts",
        "src/application/ports/account.ts",
        "src/application/ports/auth.ts",
        "src/application/ports/calendar.ts",
        "src/application/ports/files.ts",
        "src/application/ports/object-storage.ts",
        "src/application/ports/roles.ts",
        "src/application/ports/settings.ts",
        "src/application/ports/users.ts",
        "src/infrastructure/localization/catalogs/ar.ts",
        "src/infrastructure/localization/catalogs/de.ts",
        "src/infrastructure/localization/catalogs/en.ts",
        "src/infrastructure/localization/catalogs/es.ts",
        "src/infrastructure/localization/catalogs/fa.ts",
        "src/infrastructure/localization/catalogs/fr.ts",
        "src/infrastructure/localization/catalogs/index.ts",
        "src/infrastructure/localization/catalogs/it.ts",
        "src/infrastructure/localization/catalogs/pt.ts",
        "src/infrastructure/localization/catalogs/ru.ts",
        "src/infrastructure/localization/catalogs/tr.ts"
      ],
      "contracts": [
        "src/contracts",
        ".agents/rules/backend.md",
        ".agents/rules/data-lifecycle.md",
        ".agents/rules/localization.md",
        "docs/input-validation.md",
        "docs/localization.md",
        "docs/sequences.md"
      ],
      "tests": [
        "src/application/account.test.ts",
        "src/application/auth.test.ts",
        "src/application/files.test.ts",
        "src/application/management.test.ts",
        "src/application/users.test.ts",
        "src/infrastructure/localization/catalogs.test.ts"
      ],
      "checks": ["boundaries", "typecheck", "lint", "coverage-tests"]
    },
    {
      "id": "configuration-and-storage",
      "when": "Change runtime configuration, translation, logging, fatal handlers or local/MinIO storage adapters.",
      "owners": [
        "src/infrastructure/config.ts",
        "src/infrastructure/lifecycle.ts",
        "src/infrastructure/localization/i18n.ts",
        "src/infrastructure/logging",
        "src/infrastructure/storage"
      ],
      "contracts": [
        "src/application/ports/object-storage.ts",
        "docs/backend-logging.md",
        "docs/object-storage.md",
        ".agents/rules/localization.md",
        ".agents/rules/data-lifecycle.md"
      ],
      "tests": [
        "src/infrastructure/config.test.ts",
        "src/infrastructure/lifecycle.test.ts",
        "src/infrastructure/localization/i18n.test.ts",
        "src/infrastructure/logging/logger.test.ts",
        "src/infrastructure/storage/local.test.ts",
        "src/infrastructure/storage/minio.test.ts"
      ],
      "checks": ["boundaries", "typecheck", "lint", "coverage-tests"]
    },
    {
      "id": "database-auth",
      "when": "Change schema, reviewed migrations, persistence, authentication adapters or administrator provisioning.",
      "owners": [
        "drizzle",
        "src/infrastructure/db",
        "src/infrastructure/persistence",
        "src/infrastructure/auth",
        "src/infrastructure/admin/bootstrap.ts",
        "src/bootstrap-admin.ts"
      ],
      "contracts": [
        "docs/database-schema.md",
        "docs/auth-adapters.md",
        ".agents/rules/backend.md",
        ".agents/rules/data-lifecycle.md"
      ],
      "tests": [
        "scripts/auth-bootstrap-integration.test.mjs",
        "scripts/auth-identity-integration.test.mjs",
        "src/infrastructure/auth/gateway.test.ts",
        "src/test/integration/management-services.test.ts",
        "src/test/integration/persistence.test.ts",
        "src/test/integration/users-lifecycle.test.ts",
        "src/test/support/fixture-cleanup.test.ts",
        "scripts/runtime-seed.test.mjs"
      ],
      "checks": ["boundaries", "typecheck", "lint", "coverage-tests"]
    },
    {
      "id": "http-contract",
      "when": "Change HTTP routes, local server composition or API-backed client-screen contracts.",
      "owners": [
        "src/presentation/http",
        "src/composition.ts",
        "src/dependencies.ts",
        "src/index.ts"
      ],
      "contracts": [
        "docs/http-transport.md",
        "docs/development.md",
        "src/contracts",
        ".agents/rules/backend.md",
        "docs/collection-guide.md"
      ],
      "tests": [
        "scripts/http-upload-loopback.test.mjs",
        "scripts/runtime-integration.test.mjs",
        "src/test/architecture/boundaries.test.ts",
        "src/test/integration/app.test.ts",
        "src/test/integration/deletion-lifecycle-http.test.ts",
        "src/test/integration/http-transport.test.ts",
        "src/test/integration/input-validation-http.test.ts",
        "src/test/integration/request-logging.test.ts",
        "src/test/integration/upload-body-limit.test.ts",
        "src/infrastructure/lifecycle.test.ts"
      ],
      "checks": ["boundaries", "typecheck", "lint", "coverage-tests"]
    },
    {
      "id": "deployment",
      "when": "Change owned packaging, deployment templates, backup/recovery, migration tooling or manual verification/release workflows.",
      "owners": [
        "deploy",
        "compose.yaml",
        "drizzle.config.ts",
        "scripts/check-deployed-api.mjs",
        "scripts/docker-smoke-cleanup.mjs",
        "scripts/healthcheck.mjs",
        "scripts/native-smoke-cleanup.mjs",
        "scripts/package-release.mjs",
        "scripts/render-deployment.mjs",
        "scripts/test-docker-release.mjs",
        "scripts/test-native-release.mjs",
        "scripts/validate-deployment-env.mjs",
        "scripts/validate-workflow-targets.mjs",
        "scripts/website-api-runner.mjs",
        "scripts/check-operations-policy.mjs"
      ],
      "contracts": [
        "docs/deployment.md",
        "docs/backup-restore.md",
        "docs/release-operations.md",
        "docs/releasing.md",
        "docs/security/threat-model.md"
      ],
      "tests": [
        "scripts/check-deployed-api.integration.test.mjs",
        "scripts/check-deployed-api.test.mjs",
        "scripts/deployment.integration.test.mjs",
        "scripts/docker-smoke-cleanup.test.mjs",
        "scripts/healthcheck.test.mjs",
        "scripts/native-smoke-cleanup.test.mjs",
        "scripts/package-release.integration.test.mjs",
        "scripts/package-release.test.mjs",
        "scripts/render-deployment.test.mjs",
        "scripts/validate-deployment-env.test.mjs",
        "scripts/validate-workflow-targets.test.mjs",
        "scripts/website-api-runner.test.mjs",
        "src/test/architecture/drizzle-toolchain.test.ts",
        "src/test/architecture/lint-toolchain.test.ts",
        "src/test/integration/auth-invariants.test.ts",
        "src/test/integration/bootstrap-admin.test.ts",
        "src/test/integration/recovery-drill.test.ts",
        "scripts/check-operations-policy.test.mjs"
      ],
      "checks": [
        "ci-policy",
        "boundaries",
        "typecheck",
        "lint",
        "coverage-tests"
      ]
    }
  ]
}
