{
  "schemaVersion": 1,
  "phase": "database-persistence",
  "applicationReady": false,
  "checks": [
    {
      "id": "snapshot",
      "command": "npm run check:snapshot",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["database-persistence"]
    },
    {
      "id": "ci-policy",
      "command": "npm run check:ci",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["database-persistence"]
    },
    {
      "id": "actions-lint",
      "command": "npm run check:actions",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["database-persistence"]
    },
    {
      "id": "audit",
      "command": "npm run audit",
      "kind": "required",
      "ciJobs": ["audit"],
      "scopes": ["database-persistence"]
    },
    {
      "id": "boundaries",
      "command": "npm run check:boundaries",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["database-persistence"]
    },
    {
      "id": "typecheck",
      "command": "npm run typecheck",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["database-persistence"]
    },
    {
      "id": "lint",
      "command": "npm run lint",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["database-persistence"]
    },
    {
      "id": "format",
      "command": "npm run format:check",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["database-persistence"]
    },
    {
      "id": "guidance",
      "command": "npm run check:guidance",
      "kind": "required",
      "ciJobs": ["quality"],
      "scopes": ["database-persistence"]
    },
    {
      "id": "coverage-tests",
      "command": "npm run test:coverage",
      "kind": "required",
      "ciJobs": ["governance"],
      "scopes": ["database-persistence"]
    },
    {
      "id": "audit-helper-tests",
      "command": "npm run test:audit",
      "kind": "required",
      "ciJobs": ["governance"],
      "scopes": ["database-persistence"]
    }
  ],
  "profiles": {
    "full": [
      "snapshot",
      "ci-policy",
      "actions-lint",
      "audit",
      "boundaries",
      "typecheck",
      "lint",
      "format",
      "guidance",
      "coverage-tests",
      "audit-helper-tests"
    ],
    "ci-quality": [
      "snapshot",
      "ci-policy",
      "actions-lint",
      "boundaries",
      "typecheck",
      "lint",
      "format",
      "guidance"
    ],
    "ci-audit": ["audit"],
    "ci-governance": ["coverage-tests", "audit-helper-tests"]
  },
  "externalWorkflows": [
    {
      "path": ".github/workflows/ci.yml",
      "mode": "ci"
    },
    {
      "path": ".github/workflows/codeql.yml",
      "mode": "security"
    }
  ]
}
