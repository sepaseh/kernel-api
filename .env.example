# Copy this example to the repository root .env.local for local development.
# Never use these synthetic placeholders as deployed credentials.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
SERVER_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
# Relative file/storage paths are repository-root-relative, not cwd-relative.
DATABASE_URL=file:server/data/kernel.sqlite
LOCAL_STORAGE_PATH=server/data/uploads
STORAGE_DRIVER=local
HOST=localhost
PORT=3000
SERVER_SEED_DEVELOPMENT_DATA=false
# Explicit local OTP delivery only. Production rejects a fixed OTP value.
# OTP_FIXED_CODE=123456
