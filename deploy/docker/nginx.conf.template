limit_req_zone $binary_remote_addr zone=kernel_api_auth:10m rate=5r/s;
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    return 444;
}
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    ssl_reject_handshake on;
    return 444;
}
server {
    listen 80;
    listen [::]:80;
    server_name ${API_HOST};
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; try_files $uri =404; }
    location / { return 308 https://$host:${HTTPS_PORT}$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_HOST};
    ssl_certificate /etc/kernel/tls/fullchain.pem;
    ssl_certificate_key /etc/kernel/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 6m;
    proxy_cache off;
    add_header X-Content-Type-Options "nosniff" always;
    location = /_kernel/release {
        default_type application/json;
        add_header Cache-Control "no-store" always;
        return 200 '{"release":"${RELEASE_ID}","application":"kernel-api"}';
    }
    location / {
        proxy_pass http://api:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }
    location ^~ /auth/ {
        client_max_body_size 64k;
        limit_req zone=kernel_api_auth burst=20 nodelay;
        limit_req_status 429;
        proxy_pass http://api:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Connection "";
    }
}
