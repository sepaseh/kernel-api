NODE_ENV=production
SERVER_ENVIRONMENT=production
SERVER_RELEASE_ID=replace-with-immutable-release-id
HOST=127.0.0.1
PORT=3000
BETTER_AUTH_SECRET=REPLACE_WITH_A_GENERATED_RANDOM_SECRET
BETTER_AUTH_URL=https://api.example.com
SERVER_ALLOWED_ORIGINS=https://example.com,https://admin.example.com
DATABASE_URL=file:/var/lib/kernel-api/kernel.sqlite
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/var/lib/kernel-api/uploads
UPLOAD_LIMIT_BYTES=5242880
LOG_LEVEL=info
SERVER_SEED_DEVELOPMENT_DATA=false
# Never set OTP_FIXED_CODE in production. Real OTP delivery is not implemented.
# To use MinIO instead, set STORAGE_DRIVER=minio and configure all required
# MINIO_* settings described in docs/api-runtime.md. Non-loopback requires TLS.
