meta {
  name: Get Content Category
  type: http
  seq: 3
}

get {
  url: {{base_url}}/content-categories/{{content_category_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Accept: application/json
}

docs {
  ## Purpose

  Retrieves a category by ID.

  ## Authentication

  Requires a valid access token with content-categories.read.

  ## Response

  - `200 OK` — The category with its ID and name.
  - `401 Unauthorized` — Authentication is missing or invalid.
  - `403 Forbidden` — The authenticated user cannot read category details.
  - `404 Not Found` — The category does not exist.
}
