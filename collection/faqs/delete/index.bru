meta {
  name: Delete FAQ
  type: http
  seq: 5
}

delete {
  url: {{base_url}}/faqs/{{faq_id}}
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Accept: application/json
}

docs {
  ## Purpose

  Permanently deletes the FAQ identified by `faq_id`.

  ## Authentication

  Requires a valid access token with `faqs.delete` permission.

  ## Response

  - `200 OK` — FAQ deleted, with an empty response body.
  - `401 Unauthorized` — Authentication is missing or invalid.
  - `403 Forbidden` — The authenticated user lacks the required permission.
  - `404 Not Found` — The FAQ does not exist.
}
