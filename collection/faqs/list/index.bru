meta {
  name: List FAQs
  type: http
  seq: 1
}

get {
  url: {{base_url}}/faqs
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Accept: application/json
}

docs {
  ## Purpose

  Lists all FAQs in saved display order.

  ## Authentication

  Requires a valid access token with `faqs.read` permission.

  ## Response

  - `200 OK` — Returns an array of question and answer records.
  - `401 Unauthorized` — Authentication is missing or invalid.
  - `403 Forbidden` — The authenticated user lacks the required permission.
}
