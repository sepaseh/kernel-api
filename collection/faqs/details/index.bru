meta {
  name: Get FAQ
  type: http
  seq: 3
}

get {
  url: {{base_url}}/faqs/{{faq_id}}
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

headers {
  Accept: application/json
}

docs {
  ## Purpose

  Retrieves the FAQ identified by `faq_id`.

  ## Authentication

  Requires a valid access token with `faqs.read` permission.

  ## Response

  - `200 OK` — Returns the FAQ.
  - `401 Unauthorized` — Authentication is missing or invalid.
  - `403 Forbidden` — The authenticated user lacks the required permission.
  - `404 Not Found` — The FAQ does not exist.
}
