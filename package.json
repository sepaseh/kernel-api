    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "pino-pretty": "13.2.0"
  },
  "overrides": {
    "minimatch@10.2.6": "11.0.3",
    "@better-auth/core": "1.7.14"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "i18next": "26.5.12",
    "pino": "10.4.0",
    "@libsql/client": "0.18.0",
    "drizzle-orm": "0.45.4",
    "better-auth": "1.7.14",
    "@better-auth/drizzle-adapter": "1.7.14",
    "hono": "4.13.14",
    "@hono/node-server": "2.1.5"
  }
