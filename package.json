{
  "name": "kernel-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "validate": "node scripts/check-governance.mjs",
    "check:snapshot": "node scripts/check-governance.mjs snapshot",
    "check:ci": "node scripts/check-governance.mjs ci-policy",
    "check:actions": "node scripts/run-actionlint.mjs",
    "audit": "node scripts/run-audit.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format:check": "node scripts/check-governance.mjs format",
    "check:guidance": "node scripts/check-governance.mjs guidance",
    "test:coverage": "node scripts/check-governance.mjs coverage-tests",
    "test:audit": "node scripts/check-governance.mjs audit-helper-tests",
